<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOTI Custom Data Importer" Height="600" Width="900" 
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Group Browser) -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Device Groups" FontWeight="Bold" Margin="10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="SearchBox" Grid.Row="0" Margin="10,35,10,10" Height="25" VerticalContentAlignment="Center" Padding="5,0"
                         Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
                
                <TreeView x:Name="GroupTree" Grid.Row="1" Margin="10" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}">
                    <!-- Tree items would be bound here -->
                    <TreeViewItem Header="My Company" IsExpanded="True" Foreground="{DynamicResource TextPrimaryBrush}">
                        <TreeViewItem Header="Warehouses" Foreground="{DynamicResource TextPrimaryBrush}">
                            <TreeViewItem Header="Toronto" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TreeViewItem Header="New York" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Sales" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TreeViewItem>
                </TreeView>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Import Custom Data" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Select source file or enter manually" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,20"/>
                </StackPanel>
                
                <!-- Theme Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                     <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                     <ComboBox x:Name="ThemeSelector" Width="100" VerticalAlignment="Center">
                        <ComboBoxItem Content="System" IsSelected="True"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                     </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Source Tabs -->
            <TabControl Grid.Row="1" Height="200" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                <TabItem Header="Manual Entry" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Property Name" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="ManualKey" Height="25" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Value" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="ManualValue" Height="25" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
                        </StackPanel>
                        <Button Content="Add" Grid.Column="2" Width="60" Height="25" VerticalAlignment="Bottom" Margin="10,0,0,0"
                                Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
                    </Grid>
                </TabItem>
                <TabItem Header="INI File" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                    <StackPanel Margin="10">
                        <Button Content="Select Settings.ini..." Width="150" HorizontalAlignment="Left" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
                        <CheckBox Content="Import all sections as keys" Margin="0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="JSON File" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                     <StackPanel Margin="10">
                        <Button Content="Select Data.json..." Width="150" HorizontalAlignment="Left" Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Custom Definitions List -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,20,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="15,10">
                        <TextBlock Text="Custom Definitions" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Content="+" Width="30" Height="30" HorizontalAlignment="Right" 
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextInvertedBrush}" FontWeight="Bold" 
                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="15"/>
                                    </Style>
                                </Button.Resources>
                        </Button>
                    </Grid>
                    
                    <!-- List -->
                    <DataGrid x:Name="CustomDefinitionsGrid" Grid.Row="1" AutoGenerateColumns="False" 
                              BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HeaderBorderBrush}" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                              Background="{DynamicResource PanelBackgroundBrush}" RowHeaderWidth="0" CanUserAddRows="False">
                        <DataGrid.Resources>
                             <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundBrush}"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource HeaderBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Name Column -->
                            <DataGridTemplateColumn Header="NAME" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource AccentBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Build Type Column -->
                            <DataGridTextColumn Header="BUILD TYPE" Binding="{Binding BuildType}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <!-- Actions/Toggle Column (Mocking Toggle with CheckBox for now) -->
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Action Bar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <CheckBox Content="Dry Run" VerticalAlignment="Center" Margin="0,0,20,0" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Content="Apply to Selected Groups" Padding="15,8" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextInvertedBrush}" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
