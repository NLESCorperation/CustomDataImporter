<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window/Page Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2D2D30"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextInvertedBrush" Color="#FFFFFF"/>

    <!-- Borders and Dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#3E3E42"/>
    
    <!-- Controls (Buttons, Inputs) -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#333337"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#3E3E42"/>
    
    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0063B1"/>
    
    <!-- DataGrid specific -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#3E3E42"/>
</ResourceDictionary>
