<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window/Page Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TextInvertedBrush" Color="#FFFFFF"/>

    <!-- Borders and Dividers -->
    <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#E0E0E0"/>
    
    <!-- Controls (Buttons, Inputs) -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    
    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E"/>
    
    <!-- DataGrid specific -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#F0F0F0"/>
</ResourceDictionary>
